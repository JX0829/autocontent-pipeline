# Environment & Secrets
.env
*.env
*.env.local

# Accounts & Credentials
# config/accounts.yaml 可以作为模版提交，但需确保无真实密码/密钥
config/probe_config.yaml
# Browser cookies & sessions
cookies.json
**/cookies*.json
**/storage_state.json
**/browser_profiles/
*bilibili_qr*.json
data/*qr*.json

# 运行时产物（图片/音视频只会产生在这三处；不要用 *.png 一刀切，
# 否则 renderer/public 里真需要的静态素材永远提交不进来）
data/**/*.png
data/**/*.jpg
data/**/*.jpeg
data/**/*.mp4
data/**/*.mp3
data/**/*.wav
renderer/output/

# Runtime Data & Logs
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.jsonl
data/*.json
data/*.txt
data/*.log
data/drafts/
*.log
output/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node & Remotion
renderer/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Remotion Output / Cache
.remotion
renderer/public/tasks/
renderer/public/runs/

# 渲染必需的静态素材：必须提交（曾经被上面的 *.wav 一刀切掉，
# 导致 fresh clone 里 Root.tsx 引用的 sfx/bgm_loop.wav 不存在）
!renderer/public/sfx/
!renderer/public/sfx/*.wav

# External submodules / tools
external/MediaCrawler/
external/MediaCrawler/.venv/

# OS / Editor
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/

# === T0.3 工作区卫生（spec_enhancement.md §5 T0.3）===
# 备份与快照：只留在本地，永不入库
.backup/
*.bak
*.bak_*
*.bak.*
.env.bak*
config/*.bak*

# 一次性救火脚本：作废归档，禁止入库（§6 不做清单）
scripts/_deprecated/


# T4.1：历史产物归档与 run 级 public 软链（不进版本库）
.archive/
renderer/public/runs/

# 删除类改造的本地备份（可回滚，不入库）
backup/

# 审批裁决文件（运行期状态，不入库）
data/approvals/
