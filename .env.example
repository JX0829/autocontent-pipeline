# .env.example —— 配置面唯一清单（T1.9）
#
# 用法：
#   cp .env.example .env && 按注释填值
#
# 规则（对齐 pipeline.yaml contract.config_binding）：
#   · [必填] 缺失 ⇒ runner 第 0 步立即 EXIT=78，不会跑到第 3 步才炸
#   · [可选] 只在对应功能分支需要，缺失不阻断干跑
#   · 新增任何键 ⇒ 先改本文件 + pipeline.yaml（providers.*.env 或 config_binding.optional_env）
#   · 死键零容忍：写了没人读的键，scripts/audit_config.py 会报 DEADKEY

# ==================== LLM（必填）====================
# 网关地址，末尾带 /v1
LLM_BASE_URL=http://127.0.0.1:8317/v1
# 网关 API Key（敏感：日志与异常中自动掩码为 ab****yz）
LLM_API_KEY=
# 主模型：脚本扩写 / JSON 结构化输出（契约见 pipeline.yaml providers.llm.main）
LLM_MODEL_MAIN=deepseek-v4.1-flash
# 快模型：评论分类 / 短回复（契约见 providers.llm.fast）
LLM_MODEL_FAST=deepseek-v4.1-flash

# ==================== TTS（必填）====================
# 科技向音色（Edge-TTS 音色名）
TTS_VOICE_TECH=zh-CN-YunxiNeural
# 资讯向音色
TTS_VOICE_NEWS=zh-CN-XiaoxiaoNeural
# 语速，形如 +10% / -5%
TTS_RATE=+10%

# ==================== 数据库（必填）====================
SQLITE_DB_PATH=data/pipeline_state.db

# ==================== 飞书（可选）====================
# 仅当 APPROVAL_MODE=feishu 或使用飞书投料通道（--material feishu）时需要
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 审批卡片投递的群/会话 ID
FEISHU_APPROVAL_CHAT_ID=
# 通用默认群 ID（部分通知脚本使用）
FEISHU_DEFAULT_CHAT_ID=

# ==================== 抓取代理 / 凭证（可选）====================
# 小红书探测代理与 Cookie（部分抓取脚本使用）
XHS_PROBE_PROXY=
XHS_PROBE_COOKIE=
# Twitter/X 探测凭证
TWITTER_PROXY=
TWITTER_CT0=
TWITTER_AUTH_TOKEN=

# ==================== 自检/CI 覆盖（可选，勿写进生产 .env）====================
# 把 env 文件指到别处（/dev/null 可真实模拟"缺键"场景）
AUTOCONTENT_ENV_FILE=
# 台账目录重定向（hook 自检用，避免污染 data/*.jsonl）
AUTOCONTENT_DATA_DIR=
# 发送告警流路径（可选；默认 data/alerts.jsonl）
AUTOCONTENT_ALERTS_FILE=
FEISHU_CARD_WS=0
